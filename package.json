{
	"type": "module",
	"version": "0.0.2610",
	"scripts": {
		"start": "npm run build-monaco-workers && swes dev",
		"build-monaco-workers": "esbuild --bundle --target=es2017 --outdir=.monaco node_modules/monaco-editor/esm/vs/editor/editor.worker.js node_modules/monaco-editor/esm/vs/language/css/css.worker.js node_modules/monaco-editor/esm/vs/language/html/html.worker.js node_modules/monaco-editor/esm/vs/language/json/json.worker.js node_modules/monaco-editor/esm/vs/language/typescript/ts.worker.js",
		"build": "npm run build-monaco-workers && swes build",
		"release": "git push --force origin HEAD:production"
	},
	"devDependencies": {
		"@primer/octicons": "19",
		"@types/wicg-file-system-access": "^2023.10.7",
		"@webgpu/types": "^0.1.54",
		"monaco-editor": "0.52",
		"musiq": "benjamingwynn/musiq",
		"svelte": "4",
		"swes": "benjamingwynn/swes",
		"ts-blank-space": "^0.6.1",
		"music-metadata": "^12.0.0",
		"typescript": "5.8"
	}
}
